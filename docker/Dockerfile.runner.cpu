# AI Studio runner — no GPU.
#
# There is one queue and a runner takes one job at a time, so an upload to
# Hugging Face or a dataset written by a hosted model -- neither of which
# touches a GPU -- sits behind however many hours of training are in front of
# it. This image exists to take that work instead: it runs next to the
# controller on the same modest machine, and is restricted by
# AI_STUDIO_RUNNER_KINDS to the kinds of job that need no card.
#
# It carries torch, but the CPU build of it. Merging an adapter into its base
# is one addition per weight and touches no GPU at all, so making it wait for
# the card is the same mistake as making an upload wait for the card -- worse,
# because a fine-tune cannot be published until its merge has run, and the
# merge was queueing behind the next training job. That is the whole reason
# the CPU wheel is worth the gigabyte it adds: without it this image cannot
# import torch, and the merge fails on arrival.
#
# Nothing here imports torch, transformers or peft at module level -- every
# job imports what it needs inside its own function -- so the agent and the
# capability probe still start on a machine where the install went wrong, and
# a training job handed to this machine anyway fails with a plain message in
# that run's log rather than doing something worse.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/data/hf \
    AI_STUDIO_RUNNER_STATE=/data/runner-id

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Only what the GPU-less job kinds actually use: the websocket to the
# controller, an HTTP client for hosted models and artifact downloads, and the
# Hub client for uploads. hf_transfer makes a multi-gigabyte upload noticeably
# faster and is optional at runtime.
RUN pip install --no-cache-dir \
        httpx>=0.27 websockets>=12 "huggingface-hub[hf_transfer]>=0.25"

# The processor build of torch, from PyTorch's own index. The default wheel on
# PyPI drags in several gigabytes of CUDA libraries that would never be opened
# on a machine with no card; this one is a fraction of the size and is the
# same arithmetic. Installed in its own layer so a change to the line above
# does not rebuild it.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.4"
# `datasets` is here for the benchmarks: a published benchmark is a Hub
# dataset, and the machine that scores it fetches it the way the tools that
# publish those numbers do. Without it a benchmark run reaches the machine,
# loads the model, and only then discovers it cannot read the questions.
RUN pip install --no-cache-dir \
        "transformers>=4.44" "peft>=0.12" "accelerate>=0.33" "safetensors>=0.4" \
        "datasets>=2.20" "Pillow>=10"

# llama.cpp, for turning a finished model into the one file everything outside
# this studio wants. Two pieces: a Python converter that reads safetensors and
# writes GGUF, and a compiled `llama-quantize` that shrinks it.
#
# Pinned to a tag rather than to main. The converter is the part that knows
# about model architectures and it changes weekly; a model that converted last
# month and does not this month, because an image was rebuilt, is the worst
# kind of surprise. Move the pin deliberately.
#
# Only the quantiser is built -- not the server, not the CLI, not the tests --
# which keeps this to a couple of minutes and a few tens of megabytes.
ARG LLAMA_CPP_TAG=b4586
# libgomp1 is not a build dependency: llama-quantize links against the OpenMP
# runtime and needs it at run time. It arrives with build-essential, which is
# purged below, and the first build of this image shipped a binary that could
# not start -- "error while loading shared libraries: libgomp.so.1".
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && apt-get install -y --no-install-recommends \
        git build-essential cmake libcurl4-openssl-dev \
    && git clone --depth 1 --branch ${LLAMA_CPP_TAG} \
         https://github.com/ggerganov/llama.cpp /opt/llama.cpp \
    && cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
         -DCMAKE_BUILD_TYPE=Release -DLLAMA_CURL=OFF -DBUILD_SHARED_LIBS=OFF \
    && cmake --build /opt/llama.cpp/build --target llama-quantize -j "$(nproc)" \
    && cp /opt/llama.cpp/build/bin/llama-quantize /opt/llama.cpp/llama-quantize \
    && pip install --no-cache-dir -r /opt/llama.cpp/requirements/requirements-convert_hf_to_gguf.txt \
    && rm -rf /opt/llama.cpp/build /opt/llama.cpp/.git /opt/llama.cpp/tests \
    && apt-get purge -y git build-essential cmake \
    && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

COPY runner /app/runner
COPY common /app/common
COPY pyproject.toml /app/
WORKDIR /app

HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import os,time,sys; \
        f=os.environ.get('AI_STUDIO_LIVENESS','/tmp/ai-studio-runner.alive'); \
        sys.exit(0 if os.path.exists(f) and time.time()-os.path.getmtime(f) < 120 else 1)"

VOLUME ["/data"]
ENTRYPOINT ["python", "-m", "runner"]
