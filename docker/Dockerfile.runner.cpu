# AI Studio runner — no GPU.
#
# There is one queue and a runner takes one job at a time, so an upload to
# Hugging Face or a dataset written by a hosted model -- neither of which
# touches a GPU -- sits behind however many hours of training are in front of
# it. This image exists to take that work instead: it runs next to the
# controller on the same modest machine, and is restricted by
# AI_STUDIO_RUNNER_KINDS to the kinds of job that need no card.
#
# It carries torch, but the CPU build of it. Merging an adapter into its base
# is one addition per weight and touches no GPU at all, so making it wait for
# the card is the same mistake as making an upload wait for the card -- worse,
# because a fine-tune cannot be published until its merge has run, and the
# merge was queueing behind the next training job. That is the whole reason
# the CPU wheel is worth the gigabyte it adds: without it this image cannot
# import torch, and the merge fails on arrival.
#
# Nothing here imports torch, transformers or peft at module level -- every
# job imports what it needs inside its own function -- so the agent and the
# capability probe still start on a machine where the install went wrong, and
# a training job handed to this machine anyway fails with a plain message in
# that run's log rather than doing something worse.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/data/hf \
    AI_STUDIO_RUNNER_STATE=/data/runner-id

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Only what the GPU-less job kinds actually use: the websocket to the
# controller, an HTTP client for hosted models and artifact downloads, and the
# Hub client for uploads. hf_transfer makes a multi-gigabyte upload noticeably
# faster and is optional at runtime.
RUN pip install --no-cache-dir \
        httpx>=0.27 websockets>=12 "huggingface-hub[hf_transfer]>=0.25"

# The processor build of torch, from PyTorch's own index. The default wheel on
# PyPI drags in several gigabytes of CUDA libraries that would never be opened
# on a machine with no card; this one is a fraction of the size and is the
# same arithmetic. Installed in its own layer so a change to the line above
# does not rebuild it.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.4"
# `datasets` is here for the benchmarks: a published benchmark is a Hub
# dataset, and the machine that scores it fetches it the way the tools that
# publish those numbers do. Without it a benchmark run reaches the machine,
# loads the model, and only then discovers it cannot read the questions.
#
# transformers 5, pinned, because every other runner in the fleet is on it and
# a model is read by whichever machine picks it up. This line said ">=4.44",
# and the image ended up on 4.57 -- not because pip chose it here but because
# the llama.cpp layer below downgraded it -- so a Qwen fine-tune saved by the
# GPU runner on 5.17 could not even have its tokenizer opened on this one:
# "'list' object has no attribute 'keys'", from a field whose shape changed
# between the two. Pinned, a build that cannot honour it fails here, loudly,
# instead of shipping a machine that disagrees with the rest about file formats.
RUN pip install --no-cache-dir \
        "transformers>=5.0" "peft>=0.12" "accelerate>=0.33" "safetensors>=0.4" \
        "datasets>=2.20" "Pillow>=10"

# torchvision, for vision-language models (after the line above, which
# brings the numpy it imports): their processors import it even to
# read a still photograph (Qwen3-VL's carries a video processor that insists on
# it). Pinned to the release built for the torch already installed -- torch
# 2.x.y pairs with torchvision 0.(x+15).y -- and installed with --no-deps,
# because left to resolve on its own pip will happily "upgrade" torch to
# whatever torchvision it found first, from the wrong index.
RUN TV="$(python -c 'import torch; M, m, p = torch.__version__.split("+")[0].split(".")[:3]; print("0.{}.{}".format(int(m) + 15, p))')" \
    && pip install --no-cache-dir --no-deps --index-url https://download.pytorch.org/whl/cpu "torchvision==${TV}" \
    && python -c "import torch, torchvision; print('torch', torch.__version__, 'torchvision', torchvision.__version__)"

# bitsandbytes, for serving in 4-bit on the processor when the runner is told
# to (AI_STUDIO_CPU_QUANTIZATION=4bit). From 0.46 its Linux wheel carries a
# processor backend, and NF4 there measures the same ~0.1 relative error as on
# a card. --no-deps for the torchvision reason above: resolved on its own, pip
# may fetch a CUDA torch from PyPI to satisfy it. Unused unless asked for --
# the capability probe only imports it when the variable is set.
RUN pip install --no-cache-dir --no-deps "bitsandbytes>=0.50" \
    && python -c "import bitsandbytes, torch; print('bitsandbytes', bitsandbytes.__version__, 'torch', torch.__version__)"

# The grammar engine behind `response_format`. Pure Python and tiny, and in a
# layer of its own so a change to its pin does not reinstall the stack above.
RUN pip install --no-cache-dir "lm-format-enforcer>=0.10" "jsonschema>=4.0"

# llama.cpp, for turning a finished model into the one file everything outside
# this studio wants. Two pieces: a Python converter that reads safetensors and
# writes GGUF, and a compiled `llama-quantize` that shrinks it.
#
# Pinned to a tag rather than to main. The converter is the part that knows
# about model architectures and it changes weekly; a model that converted last
# month and does not this month, because an image was rebuilt, is the worst
# kind of surprise. Move the pin deliberately.
#
# Only the quantiser and the server are kept -- not the CLI, not the tests. The
# server is what a runner set to AI_STUDIO_CPU_QUANTIZATION=gguf answers
# conversations with (runner/llamacpp.py): llama.cpp's Q4_K_M kernels are the
# only quantised path that is fast on a processor without AVX-512, where
# bitsandbytes took nine seconds a token for a 7B.
#
# Built for every x86 processor rather than for the one building it. CMake's
# default is -march=native, and the image is built on a GitHub runner with
# AVX-512: the first build of the server died with "Illegal instruction" on
# the lab's Ryzen 5 5600 before it printed its version. So, as llama.cpp's
# own images do, the CPU code is built once per instruction-set level as a
# loadable backend (GGML_CPU_ALL_VARIANTS) and the best one this machine can
# run is picked when the server starts. That needs shared libraries; they go
# beside the binaries, which look for them there ($ORIGIN).
#
# Its converter gets an environment of its own, and this is not tidiness. Its
# requirements pin `torch~=2.2.1` and `transformers<5.0.0`, and installed into
# the runner's environment they quietly replaced the torch the layer above
# asked for (>=2.4) and dragged transformers back to 4.x -- the whole runner
# downgraded to suit one script. In /opt/llama.cpp/venv the converter keeps
# exactly what it was tested against, and nothing else is affected by it.
# Moved from b4586 (January 2025) on 26.09.2026: that converter predates Qwen3
# and every vision model, and its multimodal projector export (`--mmproj`)
# did not exist yet. v0.5.0 converts Qwen3, Qwen3-VL and the projector.
ARG LLAMA_CPP_TAG=v0.5.0
# libgomp1 is not a build dependency: llama-quantize links against the OpenMP
# runtime and needs it at run time. It arrives with build-essential, which is
# purged below, and the first build of this image shipped a binary that could
# not start -- "error while loading shared libraries: libgomp.so.1".
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
    && apt-get install -y --no-install-recommends \
        git build-essential cmake libcurl4-openssl-dev \
    && git clone --depth 1 --branch ${LLAMA_CPP_TAG} \
         https://github.com/ggerganov/llama.cpp /opt/llama.cpp \
    && cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
         -DCMAKE_BUILD_TYPE=Release -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF \
         -DLLAMA_BUILD_EXAMPLES=OFF \
         -DGGML_NATIVE=OFF -DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON \
         -DBUILD_SHARED_LIBS=ON \
         -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON "-DCMAKE_INSTALL_RPATH=\$ORIGIN" \
    && cmake --build /opt/llama.cpp/build -j "$(nproc)" \
    && cp /opt/llama.cpp/build/bin/llama-quantize /opt/llama.cpp/build/bin/llama-server /opt/llama.cpp/ \
    && find /opt/llama.cpp/build -name "*.so*" -exec cp -P {} /opt/llama.cpp/ \; \
    && /opt/llama.cpp/llama-server --version \
    && python -m venv /opt/llama.cpp/venv \
    && /opt/llama.cpp/venv/bin/pip install --no-cache-dir \
         -r /opt/llama.cpp/requirements/requirements-convert_hf_to_gguf.txt \
    && rm -rf /opt/llama.cpp/build /opt/llama.cpp/.git /opt/llama.cpp/tests \
    && apt-get purge -y git build-essential cmake \
    && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

COPY runner /app/runner
COPY common /app/common
COPY pyproject.toml /app/
WORKDIR /app

HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import os,time,sys; \
        f=os.environ.get('AI_STUDIO_LIVENESS','/tmp/ai-studio-runner.alive'); \
        sys.exit(0 if os.path.exists(f) and time.time()-os.path.getmtime(f) < 120 else 1)"

VOLUME ["/data"]
ENTRYPOINT ["python", "-m", "runner"]
