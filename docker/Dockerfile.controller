# AI Studio controller — the web UI and job database.
#
# Deliberately tiny: no torch, no CUDA, no ROCm. It never touches a GPU, so it
# runs anywhere, including a NAS or a Raspberry Pi.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    AI_STUDIO_DATA=/data \
    AI_STUDIO_HOST=0.0.0.0 \
    AI_STUDIO_PORT=8420

WORKDIR /app

# Dependencies come from pyproject.toml, never from a second list here. This
# file used to repeat them, and the two drifted the first time one was added:
# the tests passed locally and every template render failed in the container.
# Copying only pyproject first keeps this layer cached until the deps change.
COPY pyproject.toml /app/
RUN python -c "import tomllib; print(chr(10).join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" > /tmp/requirements.txt \
    && cat /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt

COPY controller /app/controller
COPY web /app/web
COPY common /app/common

# The runner's source, which this image serves but never runs: a machine with
# no checkout -- a Google Colab session following the notebook -- downloads it
# from here, so the runner it starts is exactly the version this controller
# speaks. Source only. None of the runner's dependencies are installed, and
# this image still has no torch, no CUDA and no ROCm in it.
COPY runner /app/runner

EXPOSE 8420
VOLUME ["/data"]

# /api/health, not /api/status. The latter needs a session and carries the
# join token, so it answers 401 to a healthcheck and marks a working
# controller unhealthy forever.
#
# Patient on purpose. Five seconds is a browser's patience, not a health
# probe's: on a four-core box with a runner merging a seven-billion-parameter
# model, the controller answers in milliseconds when it gets a time slice and
# sometimes waits seconds for one. The old settings called that unhealthy
# within ninety seconds, every time, for the length of every merge -- so the
# one signal that is supposed to mean "something is wrong" meant "somebody is
# working" instead, and got ignored accordingly. Two and a half minutes of
# consistent failure is a real fault; ten seconds of contention is not.
#
# urllib rather than httpx because this runs every thirty seconds forever, and
# on a loaded box the cheaper interpreter start is the difference between a
# probe that measures the controller and one that competes with it.
HEALTHCHECK --interval=30s --timeout=15s --start-period=30s --retries=5 \
    CMD python -c "import sys,urllib.request as u; sys.exit(0 if u.urlopen('http://127.0.0.1:8420/api/health', timeout=10).status==200 else 1)"

ENTRYPOINT ["python", "-m", "controller"]
