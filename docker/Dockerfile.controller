# AI Studio controller — the web UI and job database.
#
# Deliberately tiny: no torch, no CUDA, no ROCm. It never touches a GPU, so it
# runs anywhere, including a NAS or a Raspberry Pi.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    AI_STUDIO_DATA=/data \
    AI_STUDIO_HOST=0.0.0.0 \
    AI_STUDIO_PORT=8420

WORKDIR /app

# Dependencies come from pyproject.toml, never from a second list here. This
# file used to repeat them, and the two drifted the first time one was added:
# the tests passed locally and every template render failed in the container.
# Copying only pyproject first keeps this layer cached until the deps change.
COPY pyproject.toml /app/
RUN python -c "import tomllib; print(chr(10).join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" > /tmp/requirements.txt \
    && cat /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt

COPY controller /app/controller
COPY web /app/web
COPY common /app/common

EXPOSE 8420
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import httpx,sys; sys.exit(0 if httpx.get('http://127.0.0.1:8420/api/status').status_code==200 else 1)"

ENTRYPOINT ["python", "-m", "controller"]
