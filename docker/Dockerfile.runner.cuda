# AI Studio runner — NVIDIA / CUDA
#
# Needs the NVIDIA Container Toolkit on the host; run with `--gpus all`.
#
# CUDA 12.8: PyTorch stopped publishing cu124 builds after 2.6, so the old base
# pinned this image three releases behind the ROCm runner it trains alongside,
# and cu124 has no kernels for Blackwell cards (RTX 50xx, B200) that rented
# GPUs increasingly are. Needs a host driver of 570 or newer.
ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
FROM ${CUDA_IMAGE}

ARG TORCH_INDEX=https://download.pytorch.org/whl/cu128

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/data/hf \
    AI_STUDIO_RUNNER_STATE=/data/runner-id

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip wheel \
    && pip install --no-cache-dir torch --index-url ${TORCH_INDEX}

# On CUDA the stock bitsandbytes wheel is correct, so 4-bit works out of the
# box -- no source build needed, unlike the ROCm image.
#
# Quoted: unquoted, the shell read `transformers>=4.44` as `transformers`
# redirected into a file named "=4.44", so none of these lower bounds was ever
# applied. transformers 5, pinned, as on the CPU runner: a model is read by
# whichever machine picks it up, and a tokenizer saved on 5.x cannot be opened
# on 4.x (see docker/Dockerfile.runner.cpu).
RUN pip install --no-cache-dir \
        "transformers>=5.0" "peft>=0.12" "accelerate>=0.34" "datasets>=2.20" \
        "Pillow>=10" \
        "safetensors>=0.4" "websockets>=12" "httpx>=0.27" numpy "bitsandbytes>=0.43"

# The grammar engine behind `response_format`. Pure Python and tiny, and
# deliberately in a layer of its own AFTER the expensive build above: putting
# it on the same pip line would invalidate the bitsandbytes source compile
# every time this pin moves, and that compile is the long pole in this image.
RUN pip install --no-cache-dir "lm-format-enforcer>=0.10" "jsonschema>=4.0"

# torchvision, for vision-language models: their processors import it even to
# read a still photograph (Qwen3-VL's carries a video processor that insists on
# it). Pinned to the release built for the torch already installed -- torch
# 2.x.y pairs with torchvision 0.(x+15).y -- and installed with --no-deps,
# because left to resolve on its own pip will happily "upgrade" torch to
# whatever torchvision it found first, from the wrong index.
RUN TV="$(python -c 'import torch; M, m, p = torch.__version__.split("+")[0].split(".")[:3]; print("0.{}.{}".format(int(m) + 15, p))')" \
    && pip install --no-cache-dir --no-deps --index-url ${TORCH_INDEX} "torchvision==${TV}" \
    && python -c "import torch, torchvision; print('torch', torch.__version__, 'torchvision', torchvision.__version__)"

COPY runner /app/runner
COPY common /app/common
COPY pyproject.toml /app/
WORKDIR /app

# Healthy means "the agent is connected and reporting", which is what
# actually matters. Deliberately does NOT import torch: opening a second HIP/
# CUDA context beside the running agent is wasteful and can spuriously fail.
HEALTHCHECK --interval=60s --timeout=10s --start-period=900s --retries=3     CMD python -c "import os,time,sys;         f=os.environ.get('AI_STUDIO_LIVENESS','/tmp/ai-studio-runner.alive');         sys.exit(0 if os.path.exists(f) and time.time()-os.path.getmtime(f) < 120 else 1)"

VOLUME ["/data"]
ENTRYPOINT ["python", "-m", "runner"]
