# AI Studio runner — NVIDIA / CUDA
#
# Needs the NVIDIA Container Toolkit on the host; run with `--gpus all`.
#
# CUDA 12.8: PyTorch stopped publishing cu124 builds after 2.6, so the old base
# pinned this image three releases behind the ROCm runner it trains alongside,
# and cu124 has no kernels for Blackwell cards (RTX 50xx, B200) that rented
# GPUs increasingly are. Needs a host driver of 570 or newer.
ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
ARG CUDA_DEVEL_IMAGE=nvidia/cuda:12.8.1-devel-ubuntu22.04

# llama.cpp, built for the GPU, in a stage of its own: compiling the CUDA
# kernels needs nvcc and the toolkit headers, which the runtime image does not
# have and should not carry. Only the binaries, their libraries and the Python
# side (converter, gguf-py) are copied across.
#
# Why a GPU runner needs it at all: a calibrated export (llama-imatrix) reads
# a few hundred conversations through the model before quantising. On the CPU
# runner that is hours; on a card it is minutes. And the converter and the
# quantiser are the same as in the CPU image, so either machine can export.
#
# Same pin as docker/Dockerfile.runner.cpu -- move both together.
# CUDA_ARCHS: which cards the kernels are compiled for. The default covers
# Ampere (A100 80, RTX 30xx 86), Ada (89), Hopper (90) and Blackwell (120), which
# is what rented GPUs are. Building for one card is much faster:
#   docker compose build --build-arg CUDA_ARCHS=86 runner-cuda
FROM ${CUDA_DEVEL_IMAGE} AS llamacpp
ARG LLAMA_CPP_TAG=v0.5.0
ARG CUDA_ARCHS="80;86;89;90;120"
RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential cmake ca-certificates \
    && git clone --depth 1 --branch ${LLAMA_CPP_TAG} \
         https://github.com/ggerganov/llama.cpp /opt/llama.cpp \
    && cmake -S /opt/llama.cpp -B /opt/llama.cpp/build \
         -DCMAKE_BUILD_TYPE=Release -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF \
         -DLLAMA_BUILD_EXAMPLES=OFF -DGGML_CUDA=ON \
         "-DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHS}" \
         -DGGML_NATIVE=OFF -DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON \
         -DBUILD_SHARED_LIBS=ON \
         -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON "-DCMAKE_INSTALL_RPATH=\$ORIGIN" \
    && cmake --build /opt/llama.cpp/build -j "$(nproc)" \
         --target llama-quantize llama-imatrix llama-server \
    && mkdir -p /out \
    && cp /opt/llama.cpp/build/bin/llama-quantize /opt/llama.cpp/build/bin/llama-imatrix \
          /opt/llama.cpp/build/bin/llama-server /out/ \
    && find /opt/llama.cpp/build -name "*.so*" -exec cp -P {} /out/ \; \
    && cp -r /opt/llama.cpp/gguf-py /opt/llama.cpp/requirements /opt/llama.cpp/requirements.txt \
          /opt/llama.cpp/convert_hf_to_gguf.py /opt/llama.cpp/convert_lora_to_gguf.py /out/ \
    && (cp -r /opt/llama.cpp/conversion /out/ 2>/dev/null || true)

FROM ${CUDA_IMAGE}

ARG TORCH_INDEX=https://download.pytorch.org/whl/cu128

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/data/hf \
    AI_STUDIO_RUNNER_STATE=/data/runner-id

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip wheel \
    && pip install --no-cache-dir torch torchvision --index-url ${TORCH_INDEX}

# On CUDA the stock bitsandbytes wheel is correct, so 4-bit works out of the
# box -- no source build needed, unlike the ROCm image.
#
# Quoted: unquoted, the shell read `transformers>=4.44` as `transformers`
# redirected into a file named "=4.44", so none of these lower bounds was ever
# applied. transformers 5, pinned, as on the CPU runner: a model is read by
# whichever machine picks it up, and a tokenizer saved on 5.x cannot be opened
# on 4.x (see docker/Dockerfile.runner.cpu).
RUN pip install --no-cache-dir \
        "transformers>=5.0" "peft>=0.12" "accelerate>=0.34" "datasets>=2.20" \
        "Pillow>=10" \
        "safetensors>=0.4" "websockets>=12" "httpx>=0.27" numpy "bitsandbytes>=0.43"

# The grammar engine behind `response_format`. Pure Python and tiny, and
# deliberately in a layer of its own AFTER the expensive build above: putting
# it on the same pip line would invalidate the bitsandbytes source compile
# every time this pin moves, and that compile is the long pole in this image.
RUN pip install --no-cache-dir "lm-format-enforcer>=0.10" "jsonschema>=4.0"

# torchvision came with torch above, in one resolve from the same index:
# each torchvision pins the torch it was built for, so pip takes the newest
# published pair. Check it survived the layers in between.
RUN python -c "import torch, torchvision; print('torch', torch.__version__, 'torchvision', torchvision.__version__)"

# The GPU llama.cpp from the stage above, and the converter's own environment
# (it pins an older torch and transformers than the runner -- see the CPU
# image for why that has to be a venv of its own). libgomp1 is what the
# binaries link for OpenMP at run time.
COPY --from=llamacpp /out /opt/llama.cpp
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/llama.cpp/venv \
    && /opt/llama.cpp/venv/bin/pip install --no-cache-dir \
         -r /opt/llama.cpp/requirements/requirements-convert_hf_to_gguf.txt \
    && /opt/llama.cpp/llama-quantize --help >/dev/null 2>&1; \
    test -x /opt/llama.cpp/llama-imatrix

COPY runner /app/runner
COPY common /app/common
COPY pyproject.toml /app/
WORKDIR /app

# Healthy means "the agent is connected and reporting", which is what
# actually matters. Deliberately does NOT import torch: opening a second HIP/
# CUDA context beside the running agent is wasteful and can spuriously fail.
HEALTHCHECK --interval=60s --timeout=10s --start-period=900s --retries=3     CMD python -c "import os,time,sys;         f=os.environ.get('AI_STUDIO_LIVENESS','/tmp/ai-studio-runner.alive');         sys.exit(0 if os.path.exists(f) and time.time()-os.path.getmtime(f) < 120 else 1)"

VOLUME ["/data"]
ENTRYPOINT ["python", "-m", "runner"]
